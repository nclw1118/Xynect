DATABASE_URL=postgresql://xynect:xynect_password@localhost:5432/xynect_mvp
BACKEND_PORT=8000
UPLOAD_DIR=./storage/uploads
SESSION_TTL_HOURS=24
MAX_UPLOAD_MB=75

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# FRONTEND_URL is used for backend CORS. Set to your deployed frontend URL in production.
# Default allows http://localhost:3000 automatically even if this is not set.
FRONTEND_URL=http://localhost:3000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM_PROVIDER controls which extraction provider is used.
# Use "stub" for local development (no API key required).
# Use "openai" for real PDF/image extraction (requires OPENAI_API_KEY).
LLM_PROVIDER=stub
LLM_MODEL=gpt-4.1

# ── Stage 5A: hybrid local + GCS archival ───────────────────────────────────
# Local disk stays the working copy. When GCS_ENABLED=true, a copy of the
# original upload and the extraction debug artifacts is pushed to GCS AFTER
# extraction completes (durable archive only, not the source of truth).
GCS_ENABLED=false
GCS_BUCKET_NAME=
GCS_UPLOAD_PREFIX=uploads
GCS_DEBUG_PREFIX=extraction_debug
GCS_UPLOAD_AFTER_EXTRACTION=true
